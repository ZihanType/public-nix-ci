    "nmbcckfgobecechfdamananmfnnjbbbd", // Imp Translate
    "homllehcipjgpbpepcojhgcpfdopjhml", // QuickGo 外链直达 — 无感知自动跳过*乎、*书、掘*金、C**N、少数派、Gi**e 等网站的安全中心跳转限制
    "gebbhagfogifgggkldgodflihgfeippi", // Return YouTube Dislike
